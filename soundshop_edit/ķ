<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CATALOG | Sound Shop Premium Library</title>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;700;900&display=swap');
        :root { --teal: #00ffcc; --dark: #020202; --glass: rgba(255, 255, 255, 0.05); }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background: var(--dark); color: #ffffff; font-family: 'Inter', sans-serif; line-height: 1.6;
            background-image: linear-gradient(rgba(0,0,0,0.9), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=2000');
            background-size: cover; background-attachment: fixed;
        }

        nav { padding: 20px; background: rgba(0, 0, 0, 0.9); display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0, 255, 204, 0.2); }
        .logo { font-weight: 900; letter-spacing: 3px; font-size: 1rem; text-transform: uppercase; font-style: italic; }
        .logo span { color: var(--teal); }
        .nav-links a { text-decoration: none; color: #fff; font-size: 0.65rem; margin-left: 10px; letter-spacing: 1px; font-weight: 700; opacity: 0.6; transition: 0.3s; }
        .nav-links a:hover { opacity: 1; color: var(--teal); }

        .header-section { padding: 40px 20px; text-align: center; }
        .header-section h1 { font-size: 2.5rem; font-weight: 900; letter-spacing: -1px; color: #fff; }
        .header-section p { color: var(--teal); font-size: 0.7rem; letter-spacing: 4px; text-transform: uppercase; margin-top: 10px; }

        /* Vibe Filter Styles */
        .vibe-filter-container { text-align: center; margin: 20px 0 40px 0; }
        .vibe-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
        .filter-btn {
            background: transparent; color: white; border: 1px solid rgba(255,255,255,0.2);
            padding: 8px 18px; border-radius: 50px; cursor: pointer; font-size: 0.65rem;
            letter-spacing: 2px; transition: 0.3s; text-transform: uppercase;
        }
        .filter-btn:hover, .filter-btn.active {
            border-color: var(--teal); color: var(--teal);
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.2);
            background: rgba(0, 255, 204, 0.05);
        }

        .catalog-container { padding: 20px; max-width: 1000px; margin: 0 auto; padding-bottom: 100px; }
        
        /* Track Card Styles */
        .track-card { 
            background: var(--glass); border: 1px solid rgba(255,255,255,0.1); padding: 20px; 
            border-radius: 20px; backdrop-filter: blur(20px); margin-bottom: 20px; 
            border-left: 4px solid var(--teal); transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .track-card:hover { border-color: var(--teal); background: rgba(255, 255, 255, 0.08); }

        .vibe-tag {
            font-size: 0.55rem; color: var(--teal); border: 1px solid var(--teal);
            display: inline-block; padding: 2px 8px; border-radius: 4px;
            margin-bottom: 10px; letter-spacing: 1px; font-weight: 700;
        }

        .track-info h2 { font-style: italic; font-size: 1.2rem; color: var(--teal); }
        .track-info p { font-size: 0.55rem; opacity: 0.4; letter-spacing: 2px; margin-bottom: 10px; }

        audio { width: 100%; filter: invert(100%) hue-rotate(180deg) brightness(1.5); margin: 15px 0; }
        
        .buy-btn { 
            background: linear-gradient(90deg, #00ffcc, #00c6ff); color: #000; border: none; 
            padding: 14px; width: 100%; border-radius: 50px; font-weight: 900; 
            cursor: pointer; text-transform: uppercase; font-size: 0.75rem; transition: 0.3s;
        }
        .buy-btn:hover { transform: scale(1.02); filter: brightness(1.2); }

        footer { text-align: center; padding: 60px 20px; color: #444; font-size: 0.5rem; letter-spacing: 3px; font-weight: 900; text-transform: uppercase; }
        
        @media (max-width: 600px) {
            .header-section h1 { font-size: 1.8rem; }
            .filter-btn { font-size: 0.55rem; padding: 6px 12px; }
        }
    </style>
</head>
